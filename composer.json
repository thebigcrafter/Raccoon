{
    "name": "thebigcrafter/raccoon",
    "description": "An entity engine for PocketMine plugins",
    "type": "library",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/axolotl-pm/PocketMine-MP",
            "no-api": true
        }
    ],
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.40",
        "axolotl-pm/pocketmine-mp": "5.49.2"
    },
    "license": "GPL-3.0-only",
    "autoload": {
        "psr-4": {
            "thebigcrafter\\raccoon\\": "src/thebigcrafter/raccoon"
        }
    },
    "authors": [
        {
            "name": "thebigcrafter"
        }
    ]
}
